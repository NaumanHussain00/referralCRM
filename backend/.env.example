# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/referral-crm

# SerpAPI Key (Get from https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Server Port
PORT=5000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Email Configuration
# For development, you can use Gmail (requires App Password if 2FA is enabled)
# For production, use a service like SendGrid, AWS SES, or Mailgun
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_or_password
EMAIL_FROM_NAME=Referral Automation

# Production Email Settings (optional - uncomment for production)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
